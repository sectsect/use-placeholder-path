    "@typescript-eslint/parser": "^6.9.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.1.1",
    "eslint": "^8.52.0",
    "eslint-config-airbnb": "^19.0.4",
