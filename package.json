{
  "name": "@sect/use-placeholder-path",
  "version": "1.4.7",
  "description": "A custom React hook to retrieve placeholder path in Next.js App Router.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint src/**/*.ts",
